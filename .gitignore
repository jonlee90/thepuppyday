# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit
.env*
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
lighthouse-*.json
analyze-lighthouse.js
nul

# Claude Code / AI tooling — never commit
.cursor/
.windsurf/
.aider*
.playwright-mcp/
.serena/

# OS / editor artifacts
.DS_Store
.idea/
.vscode/settings.json

# Data files
*.csv

# Secrets & credentials
*.pem
*.key
*.p12
*.pfx
service-account*.json
*-credentials.json

# Serwist service worker build output (generated in .next/ by turbopack, no public artifacts)

# Generated / server-only files
supabase/schema_export.sql
*.log
logs/
*.md
.claude
.agents