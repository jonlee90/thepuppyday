# ─────────────────────────────────────────────────────────────
# The Puppy Day — Production Environment Variables
# Copy to .env.production and fill in real values
# Then symlink: ln -sf .env.production .env.local
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://thepuppyday.com
NEXT_PUBLIC_APP_NAME=The Puppy Day
NEXT_PUBLIC_USE_MOCKS=false

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://jajbtwgbhrkvgxvvruaa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Phase 7 — leave placeholders until ready) ────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Resend (Email) ───────────────────────────────────────────
RESEND_API_KEY=

# ── Twilio (SMS) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Google Services ──────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_PLACE_ID=
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ── Cron Jobs ────────────────────────────────────────────────
# Shared secret for authenticating cron HTTP requests
CRON_SECRET=

# ── Site URL (used in email templates) ───────────────────────
NEXT_PUBLIC_SITE_URL=https://thepuppyday.com

# ── Sentry (optional) ───────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
